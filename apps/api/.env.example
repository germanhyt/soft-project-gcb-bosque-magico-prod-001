# Puerto 5433 = Docker (docker compose up -d). Puerto 5432 = Postgres local (ajusta user/password).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/bosque_magico?schema=public"
PORT=3000
API_CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175"
JWT_SECRET="cambiar-en-produccion"
JWT_EXPIRES_IN="8h"
# true = panel/API sin JWT (solo desarrollo local)
AUTH_DISABLED=false
ADMIN_EMAIL="admin@bosquemagico.test"
ADMIN_PASSWORD="BosqueDev123!"
# URL pública de la landing (links en WhatsApp / correo)
PUBLIC_SITE_URL="http://localhost:5173"
